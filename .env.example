# Copy to .env only if using remote Portkey calls. Never commit the real key.
PORTKEY_API_KEY=
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_PROVIDER=openai
PORTKEY_VIRTUAL_KEY=

# Local runs use the database-backed mock and do not make model API calls.
CAMPUS_CUSTOMS_LOCAL_MOCK=1

# Optional: require this token on cash approvals and database reset.
CAMPUS_CUSTOMS_APPROVAL_TOKEN=
